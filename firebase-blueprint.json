{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "A customer profile in the CRM.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Customer name" },
        "email": { "type": "string", "description": "Primary email" },
        "phone": { "type": "string", "description": "Mobile phone" },
        "segment": { "type": "string", "description": "Customer segment" },
        "tier": { "type": "string", "description": "Loyalty tier" },
        "loyaltyPoints": { "type": "number", "description": "Points" },
        "lifetimeValue": { "type": "number", "description": "LTV in VND" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "createdAt": { "type": "number", "description": "Timestamp" },
        "updatedAt": { "type": "number", "description": "Timestamp" },
        "ownerId": { "type": "string", "description": "ID of the user managing this" }
      },
      "required": ["name", "email", "createdAt", "updatedAt", "ownerId"]
    },
    "Ticket": {
      "title": "Support Ticket",
      "description": "A support request from a customer.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "description": "Auto-generated ID (YT-2026-XXXXX)" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["technical", "billing", "product", "complaint", "consultancy", "other"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["new", "processing", "pending", "resolved", "closed"] },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "agentId": { "type": "string" },
        "agentName": { "type": "string" },
        "source": { "type": "string", "enum": ["portal", "agent", "email", "chat", "zalo", "fanpage"] },
        "slaDeadline": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "metadata": { "type": "object" }
      },
      "required": ["ticketId", "title", "category", "priority", "status", "customerId", "createdAt", "updatedAt"]
    },
    "TicketComment": {
      "title": "Ticket Comment",
      "description": "A communication message within a ticket.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["customer", "agent"] },
        "content": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" }
      },
      "required": ["ticketId", "userId", "content", "createdAt"]
    },
    "Campaign": {
      "title": "Marketing Campaign",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Email", "Social", "SMS", "Call"] },
        "status": { "type": "string", "enum": ["Draft", "Active", "Paused", "Completed"] },
        "budget": { "type": "number" },
        "spent": { "type": "number" },
        "leads": { "type": "number" },
        "conversion": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      },
      "required": ["name", "type", "status", "startDate"]
    },
    "AIInsight": {
      "title": "AI Insight",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["churn_risk", "upsell_opportunity", "sentiment_alert", "revenue_forecast"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "recommendation": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "Thread": {
      "title": "Omnichannel Thread",
      "description": "A conversation thread from various channels.",
      "type": "object",
      "properties": {
        "channel": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAvatar": { "type": "string" },
        "lastMessage": { "type": "string" },
        "timestamp": { "type": "number" },
        "unread": { "type": "boolean" },
        "status": { "type": "string" },
        "sentiment": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["channel", "customerName", "timestamp", "ownerId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A centralized notification for CRM updates, task deadlines, etc.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "enum": ["info", "success", "warning", "error"] },
        "category": { "enum": ["crm", "ticket", "task", "system"] },
        "read": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "title", "message", "type", "category", "read", "createdAt"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "An audit log record representing a user action in the system.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "timestamp": { "type": "number" },
        "details": { "type": "string" }
      },
      "required": ["userId", "email", "action", "resource", "timestamp"]
    },
    "SalesVelocity": {
      "title": "Sales Velocity",
      "description": "Daily lead conversion tracking over the last 30 days.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "leadsCount": { "type": "number" },
        "convertedCount": { "type": "number" },
        "conversionRate": { "type": "number" },
        "ownerId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["date", "leadsCount", "convertedCount", "conversionRate", "ownerId", "timestamp"]
    }
  },
  "firestore": {
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit log records."
    },
    "/sales_velocity/{velocityId}": {
      "schema": { "$ref": "#/entities/SalesVelocity" },
      "description": "Sales velocity metrics."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Collection of CRM customers."
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/Ticket" },
      "description": "Collection of support tickets."
    },
    "/tickets/{ticketId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/TicketComment" },
      "description": "Sub-collection of comments for a ticket."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Collection of marketing campaigns."
    },
    "/ai_insights/{insightId}": {
      "schema": { "$ref": "#/entities/AIInsight" },
      "description": "Collection of AI-generated insights."
    },
    "/threads/{threadId}": {
      "schema": { "$ref": "#/entities/Thread" },
      "description": "Omnichannel conversation threads."
    }
  }
}
