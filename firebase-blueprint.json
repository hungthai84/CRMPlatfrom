{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated ONECRM user profile and active organization binding.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 40 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "role", "organizationId", "createdAt", "updatedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant organization workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 140 },
        "code": { "type": "string", "maxLength": 40 },
        "industry": { "type": "string", "maxLength": 80 },
        "currency": { "type": "string", "enum": ["VND", "USD"] },
        "timezone": { "type": "string", "maxLength": 60 },
        "language": { "type": "string", "enum": ["vi", "en"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "demoModeEnabled": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "code", "currency", "language", "ownerId", "demoModeEnabled", "createdAt", "updatedAt"]
    },
    "CrmEntity": {
      "title": "CrmEntity",
      "description": "Tenant-isolated CRM entity record (Customer, Lead, Deal, Task, Ticket, Product, Order, Contract, Campaign, Conversation, Workflow, Employee, Document, Loyalty).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "organizationId", "ownerId", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and operational audit trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 80 },
        "module": { "type": "string", "maxLength": 60 },
        "details": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "organizationId", "ownerId", "userId", "action", "module", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app CRM alert or SLA warning.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "category": { "type": "string", "maxLength": 40 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "organizationId", "ownerId", "userId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account & role metadata (PII isolated to owner/admin)."
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Multi-tenant organization root document."
    },
    "/organizations/{orgId}/customers/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Customer 360 records."
    },
    "/organizations/{orgId}/leads/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Lead management records."
    },
    "/organizations/{orgId}/deals/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Sales opportunities & deals."
    },
    "/organizations/{orgId}/tasks/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Tasks & calendar appointments."
    },
    "/organizations/{orgId}/tickets/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Customer service tickets & SLA."
    },
    "/organizations/{orgId}/products/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Product and service catalog."
    },
    "/organizations/{orgId}/orders/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Sales orders."
    },
    "/organizations/{orgId}/contracts/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Customer contracts."
    },
    "/organizations/{orgId}/campaigns/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Marketing campaigns."
    },
    "/organizations/{orgId}/conversations/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Omnichannel inbox threads."
    },
    "/organizations/{orgId}/workflows/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Automation workflow definitions."
    },
    "/organizations/{orgId}/employees/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Organization employees."
    },
    "/organizations/{orgId}/departments/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Organization departments."
    },
    "/organizations/{orgId}/teams/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Organization teams."
    },
    "/organizations/{orgId}/documents/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Documents & knowledge base articles."
    },
    "/organizations/{orgId}/loyalty/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Customer loyalty & retention records."
    },
    "/organizations/{orgId}/activities/{recordId}": {
      "schema": { "$ref": "#/entities/CrmEntity" },
      "description": "Cross-module customer timeline activities."
    },
    "/organizations/{orgId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only operational audit logs."
    },
    "/organizations/{orgId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications."
    }
  }
}
