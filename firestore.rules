rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Reusable Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isCustomerValid(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt', 'updatedAt', 'ownerId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.ownerId == request.auth.uid &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('segment' in data) || (data.segment is string && data.segment.size() <= 50)) &&
             (!('tier' in data) || (data.tier is string && data.tier.size() <= 50)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
             (!('loyaltyPoints' in data) || data.loyaltyPoints is number) &&
             (!('lifetimeValue' in data) || data.lifetimeValue is number);
    }

    function isTicketValid(data) {
      return data.keys().hasAll(['ticketId', 'title', 'category', 'priority', 'status', 'customerId', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.ticketId is string && data.ticketId.size() <= 64 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 10000)) &&
             data.category is string &&
             data.priority in ['low', 'medium', 'high', 'urgent'] &&
             data.status is string &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.ownerId == request.auth.uid;
    }

    function isCommentValid(data) {
      return data.keys().hasAll(['ticketId', 'userId', 'content', 'ticketOwnerId', 'createdAt']) &&
             data.ticketId is string && data.ticketId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.ticketOwnerId is string && data.ticketOwnerId.size() <= 128 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000;
    }

    function isCampaignValid(data) {
      return data.keys().hasAll(['name', 'type', 'status', 'startDate', 'ownerId']) &&
             data.name is string && data.name.size() <= 200 &&
             data.type is string &&
             data.status is string &&
             data.startDate is string &&
             data.ownerId == request.auth.uid;
    }

    function isThreadValid(data) {
      return data.keys().hasAll(['channel', 'customerName', 'timestamp', 'ownerId']) &&
             data.channel is string &&
             data.customerName is string &&
             data.timestamp is number &&
             data.ownerId == request.auth.uid;
    }

    function isNotificationValid(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'category', 'read', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.message is string &&
             data.type in ['info', 'success', 'warning', 'error'] &&
             data.category in ['crm', 'ticket', 'task', 'system'] &&
             data.read is bool &&
             data.createdAt is number;
    }

    function isAuditLogValid(data) {
      return data.keys().hasAll(['userId', 'email', 'action', 'resource', 'timestamp']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.action is string && data.action.size() <= 100 &&
             data.resource is string && data.resource.size() <= 100 &&
             data.timestamp is number &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000));
    }

    function isSalesVelocityValid(data) {
      return data.keys().hasAll(['date', 'leadsCount', 'convertedCount', 'conversionRate', 'ownerId', 'timestamp']) &&
             data.date is string && data.date.size() <= 20 &&
             data.leadsCount is number &&
             data.convertedCount is number &&
             data.conversionRate is number &&
             data.ownerId == request.auth.uid &&
             data.timestamp is number;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hungthai84@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /customers/{customerId} {
      allow get: if (isSignedIn() && isValidId(customerId) && existing().ownerId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(customerId) && 
                    isCustomerValid(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if (isSignedIn() && isValidId(customerId) && 
                    existing().ownerId == request.auth.uid &&
                    isCustomerValid(incoming()) &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(customerId) && existing().ownerId == request.auth.uid) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isNotificationValid(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isNotificationValid(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /audit_logs/{logId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isAuditLogValid(incoming());
      allow update, delete: if isAdmin();
    }

    match /sales_velocity/{velocityId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isSalesVelocityValid(incoming());
      allow update, delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /tickets/{ticketId} {
      allow get: if (isSignedIn() && isValidId(ticketId) && existing().ownerId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      
      allow create: if isSignedIn() && isValidId(ticketId) && 
                    isTicketValid(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
                    
      allow update: if (isSignedIn() && isValidId(ticketId) && 
                    isTicketValid(incoming()) &&
                    (existing().ownerId == request.auth.uid || isAdmin()) &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().customerId == existing().customerId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time) || isAdmin();
                    
      allow delete: if (isSignedIn() && isValidId(ticketId) && (existing().ownerId == request.auth.uid)) || isAdmin();

      match /comments/{commentId} {
        allow get: if (isSignedIn() && isValidId(commentId) && existing().ticketOwnerId == request.auth.uid) || isAdmin();
        allow list: if (isSignedIn() && resource.data.ticketOwnerId == request.auth.uid) || isAdmin();
        
        allow create: if isSignedIn() && isValidId(commentId) && 
                      isCommentValid(incoming()) &&
                      incoming().ticketId == ticketId &&
                      incoming().ticketOwnerId == request.auth.uid &&
                      incoming().createdAt == request.time;
      }
    }

    match /campaigns/{campaignId} {
      allow get: if (isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid)) || isAdmin();
      allow list: if (isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && isValidId(campaignId) && isCampaignValid(incoming());
      allow update: if (isSignedIn() && isValidId(campaignId) && existing().ownerId == request.auth.uid && isCampaignValid(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && isValidId(campaignId) && existing().ownerId == request.auth.uid) || isAdmin();
    }

    match /threads/{threadId} {
      allow get: if (isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isThreadValid(incoming());
      allow update: if (isSignedIn() && existing().ownerId == request.auth.uid && isThreadValid(incoming())) || isAdmin();
      allow delete: if (isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin();
    }

    match /ai_insights/{insightId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
