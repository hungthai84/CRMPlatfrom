rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'hungthai84@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Pillar 2: Entity Validation Helpers
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'organizationId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'organizationId', 'createdAt', 'updatedAt']) &&
             data.uid == userId &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role is string && data.role.size() > 0 && data.role.size() <= 40 &&
             data.organizationId is string && isValidId(data.organizationId) &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    function isValidOrganization(data, orgId) {
      return data.keys().hasAll(['id', 'name', 'code', 'currency', 'language', 'ownerId', 'demoModeEnabled', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'name', 'code', 'industry', 'taxId', 'currency', 'timezone', 'language', 'ownerId', 'demoModeEnabled', 'createdAt', 'updatedAt']) &&
             data.id == orgId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 140 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 40 &&
             data.currency in ['VND', 'USD'] &&
             data.language in ['vi', 'en'] &&
             data.ownerId == request.auth.uid &&
             data.demoModeEnabled is bool &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('industry' in data) || (data.industry is string && data.industry.size() <= 80)) &&
             (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 40)) &&
             (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 60));
    }

    function isValidTenantRecord(data, orgId, recordId) {
      return data.keys().hasAll(['id', 'organizationId', 'ownerId', 'status', 'createdAt', 'updatedAt']) &&
             data.id == recordId &&
             data.organizationId == orgId &&
             data.ownerId == request.auth.uid &&
             data.status is string && data.status.size() > 0 && data.status.size() <= 60 &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidAuditLog(data, orgId, logId) {
      return data.keys().hasAll(['id', 'organizationId', 'ownerId', 'userId', 'action', 'module', 'timestamp']) &&
             data.keys().hasOnly(['id', 'organizationId', 'ownerId', 'userId', 'userEmail', 'action', 'module', 'recordId', 'details', 'timestamp']) &&
             data.id == logId &&
             data.organizationId == orgId &&
             data.ownerId == request.auth.uid &&
             data.userId == request.auth.uid &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 80 &&
             data.module is string && data.module.size() > 0 && data.module.size() <= 60 &&
             data.timestamp is number &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 150)) &&
             (!('recordId' in data) || (data.recordId is string && data.recordId.size() <= 128)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000));
    }

    function isValidNotification(data, orgId, notifId) {
      return data.keys().hasAll(['id', 'organizationId', 'ownerId', 'userId', 'title', 'message', 'type', 'category', 'read', 'createdAt']) &&
             data.keys().hasOnly(['id', 'organizationId', 'ownerId', 'userId', 'title', 'message', 'type', 'category', 'read', 'linkModule', 'createdAt']) &&
             data.id == notifId &&
             data.organizationId == orgId &&
             data.ownerId == request.auth.uid &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ['info', 'success', 'warning', 'error'] &&
             data.category is string && data.category.size() <= 40 &&
             data.read is bool &&
             data.createdAt is number;
    }

    function isOrgOwner(orgId) {
      return isVerifiedUser() &&
             exists(/databases/$(database)/documents/organizations/$(orgId)) &&
             get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    // Pillar 6: PII-Isolated User Profiles
    match /users/{userId} {
      allow get: if (isSignedIn() && isValidId(userId) && request.auth.uid == userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) &&
                    request.auth.uid == userId &&
                    isValidUserAccount(incoming(), userId) &&
                    (incoming().role in ['org_owner', 'sales_staff', 'cs_agent', 'marketing_staff', 'read_only', 'customer_portal'] || isAdmin());
      allow update: if (isVerifiedUser() && isValidId(userId) &&
                    request.auth.uid == userId &&
                    isValidUserAccount(incoming(), userId) &&
                    incoming().uid == existing().uid &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().role == existing().role &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'organizationId', 'updatedAt'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Connection test ping document (safe read-only denied check)
    match /test/connection {
      allow get: if isSignedIn();
    }

    // Multi-Tenant Organization Root & Isolated Subcollections
    match /organizations/{orgId} {
      allow get: if (isSignedIn() && isValidId(orgId) && existing().ownerId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser() && isValidId(orgId) && isValidOrganization(incoming(), orgId);
      allow update: if (isVerifiedUser() && isValidId(orgId) &&
                    existing().ownerId == request.auth.uid &&
                    isValidOrganization(incoming(), orgId) &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'industry', 'taxId', 'currency', 'timezone', 'language', 'demoModeEnabled', 'updatedAt'])) || isAdmin();
      allow delete: if (isVerifiedUser() && isValidId(orgId) && existing().ownerId == request.auth.uid) || isAdmin();

      // Audit Logs (Append-only for org owner; admin can manage)
      match /audit_logs/{logId} {
        allow get: if (isSignedIn() && isValidId(orgId) && isValidId(logId) && existing().ownerId == request.auth.uid) || isAdmin();
        allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
        allow create: if isVerifiedUser() && isValidId(orgId) && isValidId(logId) && isOrgOwner(orgId) && isValidAuditLog(incoming(), orgId, logId);
        allow update, delete: if isAdmin();
      }

      // Notifications
      match /notifications/{notifId} {
        allow get: if (isSignedIn() && isValidId(orgId) && isValidId(notifId) && existing().ownerId == request.auth.uid) || isAdmin();
        allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
        allow create: if isVerifiedUser() && isValidId(orgId) && isValidId(notifId) && isOrgOwner(orgId) && isValidNotification(incoming(), orgId, notifId);
        allow update: if isVerifiedUser() && isValidId(orgId) && isValidId(notifId) &&
                      existing().ownerId == request.auth.uid &&
                      isValidNotification(incoming(), orgId, notifId) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if (isSignedIn() && isValidId(orgId) && isValidId(notifId) && existing().ownerId == request.auth.uid) || isAdmin();
      }

      // Standardized Multi-Tenant CRM Entity Collections
      match /{subCol}/{recordId} {
        allow get: if subCol in [
          'customers', 'leads', 'deals', 'tasks', 'tickets',
          'products', 'orders', 'contracts', 'campaigns',
          'conversations', 'workflows', 'employees', 'departments',
          'teams', 'documents', 'loyalty', 'activities'
        ] && ((isSignedIn() && isValidId(orgId) && isValidId(recordId) && existing().ownerId == request.auth.uid) || isAdmin());

        allow list: if subCol in [
          'customers', 'leads', 'deals', 'tasks', 'tickets',
          'products', 'orders', 'contracts', 'campaigns',
          'conversations', 'workflows', 'employees', 'departments',
          'teams', 'documents', 'loyalty', 'activities'
        ] && ((isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin());

        allow create: if subCol in [
          'customers', 'leads', 'deals', 'tasks', 'tickets',
          'products', 'orders', 'contracts', 'campaigns',
          'conversations', 'workflows', 'employees', 'departments',
          'teams', 'documents', 'loyalty', 'activities'
        ] && isVerifiedUser() && isValidId(orgId) && isValidId(recordId) &&
          isOrgOwner(orgId) && isValidTenantRecord(incoming(), orgId, recordId);

        allow update: if subCol in [
          'customers', 'leads', 'deals', 'tasks', 'tickets',
          'products', 'orders', 'contracts', 'campaigns',
          'conversations', 'workflows', 'employees', 'departments',
          'teams', 'documents', 'loyalty', 'activities'
        ] && ((isVerifiedUser() && isValidId(orgId) && isValidId(recordId) &&
          existing().ownerId == request.auth.uid &&
          isValidTenantRecord(incoming(), orgId, recordId) &&
          incoming().id == existing().id &&
          incoming().organizationId == existing().organizationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt) || isAdmin());

        allow delete: if subCol in [
          'customers', 'leads', 'deals', 'tasks', 'tickets',
          'products', 'orders', 'contracts', 'campaigns',
          'conversations', 'workflows', 'employees', 'departments',
          'teams', 'documents', 'loyalty', 'activities'
        ] && ((isVerifiedUser() && isValidId(orgId) && isValidId(recordId) && existing().ownerId == request.auth.uid) || isAdmin());
      }
    }
  }
}
